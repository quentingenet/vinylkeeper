{
  "name": "vinylkeeper_front",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --mode development --host 127.0.0.1",
    "build": "tsc && vite build",
    "build:prod": "tsc && vite build --mode production",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:mobile": "tsc && vite build --mode mobile",
    "mobile:prod:sync": "npx cap sync android",
    "mobile:prod": "npm run build:prod && npm run mobile:prod:sync && npx cap open android",
    "development:mobile": "npm run adb:tunnel && npm run build:mobile && npx cap sync android && npx cap run android",
    "release:android": "npm run build:prod && npx cap sync android && cd android && ./gradlew bundleRelease",
    "adb:tunnel": "adb reverse tcp:8000 tcp:8000 && adb reverse --list",
    "assets:android": "bash scripts/generate-android-assets.sh",
    "cap:sync": "npx cap sync",
    "cap:android": "npx cap open android",
    "cap:ios": "npx cap open ios"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "^8.0.1",
    "@capacitor-mlkit/barcode-scanning": "^8.2.2",
    "@capacitor/android": "^8.3.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.3.0",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/share": "^8.0.3",
    "@capawesome/capacitor-app-update": "^8.1.1",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@hookform/resolvers": "^6.0.2",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "@mui/system": "^9.5.0",
    "@mui/x-date-pickers": "^9.17.0",
    "@tanstack/react-query": "^5.107.1",
    "chart.js": "^4.6.1",
    "date-fns": "^4.4.0",
    "ky": "^2.2.0",
    "leaflet": "^1.9.4",
    "react": "^19.3.1",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.14.0",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.3.0",
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.9",
    "@types/leaflet": "^1.9.22",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "jsdom": "^30.1.3",
    "sass": "^1.108.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.7",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "minimatch": "^11.0.4",
    "glob": "^14.0.3"
  }
}
