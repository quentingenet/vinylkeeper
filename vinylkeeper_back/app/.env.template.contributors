# EXTERNAL API URL
DISCOGS_API_URL=
DISCOGS_API_KEY=

# "Connect with Discogs" (optional): leave empty to run without it, the import then shows "not available".
# Register an application in Discogs > Settings > Developers, with this callback URL.
# DISCOGS_TOKEN_KEY encrypts the users' Discogs tokens, generate it with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DISCOGS_CONSUMER_KEY=
DISCOGS_CONSUMER_SECRET=
DISCOGS_TOKEN_KEY=
DISCOGS_OAUTH_CALLBACK_URL=http://localhost:8000/api/discogs-import/oauth/callback

#USER-AGENT
USER_AGENT=