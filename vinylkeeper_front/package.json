{
  "name": "vinylkeeper_front",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --mode development --host 127.0.0.1",
    "build": "tsc && vite build",
    "build:prod": "tsc && vite build --mode production",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:mobile": "tsc && vite build --mode mobile",
    "mobile:prod:sync": "npx cap sync android",
    "mobile:prod": "npm run build:prod && npm run mobile:prod:sync && npx cap open android",
    "development:mobile": "npm run adb:tunnel && npm run build:mobile && npx cap sync android && npx cap run android",
    "release:android": "npm run build:prod && npx cap sync android && cd android && ./gradlew bundleRelease",
    "adb:tunnel": "adb reverse tcp:8000 tcp:8000 && adb reverse --list",
    "assets:android": "bash scripts/generate-android-assets.sh",
    "assets:ios": "bash scripts/generate-ios-assets.sh",
    "check:prod-bundle": "bash scripts/check-prod-bundle.sh",
    "version:check": "node scripts/app-version.mjs",
    "version:set": "node scripts/app-version.mjs set",
    "version:bump": "node scripts/app-version.mjs bump",
    "mobile:ios:dev": "npm run build:mobile && npx cap sync ios && npx cap run ios",
    "mobile:ios:prod:sync": "npm run build:prod && npm run check:prod-bundle && npx cap sync ios",
    "mobile:ios:prod": "npm run mobile:ios:prod:sync && npx cap open ios",
    "cap:sync": "npx cap sync",
    "cap:android": "npx cap open android",
    "cap:ios": "npx cap open ios"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "^8.0.1",
    "@capacitor-mlkit/barcode-scanning": "^8.2.2",
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.6.2",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/ios": "^8.6.2",
    "@capacitor/share": "^8.0.3",
    "@capawesome/capacitor-app-update": "^8.1.1",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@hookform/resolvers": "^7.0.7",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "@mui/system": "^9.5.0",
    "@mui/x-date-pickers": "^9.18.0",
    "@tanstack/react-query": "^5.108.1",
    "chart.js": "^4.6.1",
    "date-fns": "^4.4.0",
    "i18next": "^27.2.2",
    "i18next-browser-languagedetector": "^8.3.1",
    "ky": "^2.2.0",
    "leaflet": "^1.9.4",
    "react": "^19.3.1",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.92.0",
    "react-i18next": "^18.0.3",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.18.6",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/leaflet": "^1.9.22",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "sass": "^1.108.2",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "overrides": {
    "minimatch": "^11.0.4",
    "glob": "^14.0.3"
  }
}
